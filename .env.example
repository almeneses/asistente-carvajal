# =============================================================================
# Asistente Carvajal — configuración local (copiar a .env y completar)
# Ningún valor real se versiona: .env está ignorado por Git.
# =============================================================================

# --- Corpus (solo lectura) -------------------------------------------------
# Directorio con los documentos *.md y index.jsonl del corpus gold.
CORPUS_GOLD_DIR=/ruta/a/carvajal/data/gold

# --- Índice vectorial (Qdrant) --------------------------------------------
# Modo embebido persistente (por defecto); ignorar si se define QDRANT_URL.
QDRANT_PATH=.qdrant
# Servicio remoto opcional; si se define, tiene prioridad sobre QDRANT_PATH.
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=corpus_carvajal

# --- Embeddings (Ollama) ---------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# --- Generación ------------------------------------------------------------
# deepseek (primario con respaldo Ollama) u ollama (solo local)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_MODEL=qwen3:4b-instruct

# --- Recuperación y aceptación --------------------------------------------
TOP_K=5
# Archivo JSON con la lista de preguntas de aceptación (40 del proyecto carvajal)
# ACCEPTANCE_FILE=../carvajal/data/questions.json
